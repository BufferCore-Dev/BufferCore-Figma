{
  "schemaVersion": 2,
  "platform": "figma",
  "collections": {
    "primitive": {
      "name": "Primitive",
      "publish": false
    },
    "semantic": {
      "name": "Semantic",
      "publish": true
    }
  },
  "modeAliases": {
    "colour-scheme": {
      "name": "Theme",
      "values": {
        "light": "Light",
        "dark": "Dark"
      }
    },
    "viewport": {
      "name": "Viewport",
      "values": {
        "small": "Small",
        "medium": "Medium",
        "large": "Large"
      }
    }
  },
  "valueTypes": {
    "color": "COLOR",
    "dimension": "FLOAT",
    "number": "FLOAT",
    "boolean": "BOOLEAN",
    "duration": "FLOAT",
    "string": "STRING",
    "easing": "STRING",
    "expression": "STRING",
    "composite": "STRING",
    "mixed": "STRING"
  },
  "units": {
    "rootFontSizePx": 16,
    "durationUnit": "ms"
  },
  "scopeRules": [
    {
      "match": {
        "layer": "primitive"
      },
      "scopes": []
    },
    {
      "match": {
        "foundation": "colour",
        "layer": "semantic",
        "pathPrefix": [
          "color",
          "text"
        ]
      },
      "scopes": [
        "ALL_FILLS",
        "STROKE_COLOR"
      ]
    },
    {
      "match": {
        "foundation": "colour",
        "layer": "semantic",
        "pathPrefix": [
          "color",
          "fill"
        ]
      },
      "scopes": [
        "FRAME_FILL",
        "SHAPE_FILL"
      ]
    },
    {
      "match": {
        "foundation": "colour",
        "layer": "semantic",
        "pathPrefix": [
          "color",
          "surface"
        ]
      },
      "scopes": [
        "FRAME_FILL",
        "SHAPE_FILL"
      ]
    },
    {
      "match": {
        "foundation": "colour",
        "layer": "semantic",
        "pathPrefix": [
          "color",
          "canvas"
        ]
      },
      "scopes": [
        "FRAME_FILL"
      ]
    },
    {
      "match": {
        "foundation": "colour",
        "layer": "semantic",
        "pathPrefix": [
          "color",
          "border"
        ]
      },
      "scopes": [
        "STROKE_COLOR"
      ]
    },
    {
      "match": {
        "foundation": "colour",
        "layer": "semantic",
        "pathPrefix": [
          "color",
          "link"
        ]
      },
      "scopes": [
        "TEXT_FILL",
        "SHAPE_FILL"
      ]
    },
    {
      "match": {
        "foundation": "colour",
        "layer": "semantic",
        "pathPrefix": [
          "color",
          "focus"
        ]
      },
      "scopes": [
        "STROKE_COLOR"
      ]
    },
    {
      "match": {
        "foundation": "colour",
        "layer": "semantic",
        "pathPrefix": [
          "color",
          "placeholder"
        ]
      },
      "scopes": [
        "TEXT_FILL"
      ]
    },
    {
      "match": {
        "foundation": "colour",
        "layer": "semantic",
        "pathPrefix": [
          "color",
          "shadow"
        ]
      },
      "scopes": [
        "EFFECT_COLOR"
      ]
    },
    {
      "match": {
        "foundation": "colour",
        "layer": "semantic",
        "pathPrefix": [
          "color",
          "primary"
        ]
      },
      "scopes": [
        "FRAME_FILL",
        "SHAPE_FILL"
      ]
    },
    {
      "match": {
        "foundation": "colour",
        "layer": "semantic",
        "pathPrefix": [
          "color",
          "secondary"
        ]
      },
      "scopes": [
        "FRAME_FILL",
        "SHAPE_FILL"
      ]
    },
    {
      "match": {
        "foundation": "colour",
        "layer": "semantic",
        "pathPrefix": [
          "color",
          "accent"
        ]
      },
      "scopes": [
        "FRAME_FILL",
        "SHAPE_FILL"
      ]
    },
    {
      "match": {
        "foundation": "typography",
        "layer": "semantic",
        "cssVariableIncludes": "font-family"
      },
      "scopes": [
        "FONT_FAMILY"
      ]
    },
    {
      "match": {
        "foundation": "typography",
        "layer": "semantic",
        "cssVariableIncludes": "font-size"
      },
      "scopes": [
        "FONT_SIZE"
      ]
    },
    {
      "match": {
        "foundation": "typography",
        "layer": "semantic",
        "cssVariableIncludes": "font-weight"
      },
      "scopes": [
        "FONT_WEIGHT"
      ]
    },
    {
      "match": {
        "foundation": "typography",
        "layer": "semantic",
        "cssVariableIncludes": "line-height"
      },
      "scopes": [
        "LINE_HEIGHT"
      ]
    },
    {
      "match": {
        "foundation": "typography",
        "layer": "semantic",
        "cssVariableIncludes": "letter-spacing"
      },
      "scopes": [
        "LETTER_SPACING"
      ]
    },
    {
      "match": {
        "foundation": "spacing",
        "layer": "semantic"
      },
      "scopes": [
        "GAP"
      ]
    },
    {
      "match": {
        "foundation": "sizing",
        "layer": "semantic"
      },
      "scopes": [
        "WIDTH_HEIGHT",
        "GAP"
      ]
    },
    {
      "match": {
        "foundation": "radius",
        "layer": "semantic"
      },
      "scopes": [
        "CORNER_RADIUS"
      ]
    },
    {
      "match": {
        "foundation": "borders",
        "layer": "semantic"
      },
      "scopes": [
        "STROKE_FLOAT"
      ]
    },
    {
      "match": {
        "foundation": "stroke",
        "layer": "semantic"
      },
      "scopes": [
        "STROKE_FLOAT"
      ]
    },
    {
      "match": {
        "foundation": "interaction",
        "layer": "semantic",
        "pathContains": "opacity"
      },
      "scopes": [
        "OPACITY"
      ]
    },
    {
      "match": {
        "foundation": "effects",
        "layer": "semantic",
        "pathContains": "opacity"
      },
      "scopes": [
        "OPACITY"
      ]
    },
    {
      "match": {
        "foundation": "effects",
        "layer": "semantic",
        "pathContains": "blur"
      },
      "scopes": [
        "EFFECT_FLOAT"
      ]
    },
    {
      "match": {
        "foundation": "containers",
        "layer": "semantic",
        "pathContains": "gutter"
      },
      "scopes": [
        "GAP"
      ]
    },
    {
      "match": {
        "foundation": "containers",
        "layer": "semantic"
      },
      "scopes": [
        "WIDTH_HEIGHT"
      ]
    }
  ],
  "naming": {
    "separator": " / ",
    "primitiveColour": {
      "tint": "T{value}",
      "shade": "S{value}",
      "base": "Base"
    }
  },
  "textStyles": {
    "enabled": true,
    "roles": {
      "display": [
        1,
        2,
        3,
        4,
        5,
        6
      ],
      "heading": [
        1,
        2,
        3,
        4,
        5,
        6
      ],
      "paragraph": [
        1,
        2,
        3,
        4
      ],
      "label": [
        1,
        2,
        3,
        4
      ],
      "overline": [
        1,
        2
      ]
    },
    "properties": [
      "font-family",
      "font-size",
      "font-weight",
      "line-height",
      "letter-spacing"
    ],
    "verticalTrim": {
      "figma": "NONE",
      "css": "normal line box"
    },
    "searchPrefixes": {
      "display": "D",
      "heading": "H",
      "paragraph": "P",
      "label": "L",
      "overline": "O"
    },
    "lineHeight": {
      "unitlessAsPercent": true
    }
  },
  "effectStyles": {
    "enabled": true,
    "blurPrefix": [
      "blur"
    ],
    "shadowFoundation": "shadows"
  },
  "divider": {
    "enabled": true,
    "id": "divider.semantic-primitive",
    "name": "\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"
  },
  "foundationOrder": [
    "colour",
    "typography",
    "spacing",
    "sizing",
    "radius",
    "borders",
    "stroke",
    "shadows",
    "motion",
    "effects",
    "breakpoints",
    "containers",
    "z-index"
  ],
  "foundationNames": {
    "colour": "Colour",
    "typography": "Typography",
    "spacing": "Spacing",
    "sizing": "Sizing",
    "radius": "Radius",
    "borders": "Borders",
    "stroke": "Stroke",
    "shadows": "Shadows",
    "motion": "Motion",
    "effects": "Effects",
    "breakpoints": "Breakpoints",
    "containers": "Containers",
    "z-index": "Z-index"
  },
  "collectionOrdering": {
    "strategy": "leading-spaces",
    "enabled": true
  },
  "viewportSampling": {
    "enabled": true,
    "dimension": {
      "id": "viewport",
      "name": "Viewport",
      "values": [
        {
          "id": "small",
          "name": "Small",
          "widthPx": 480
        },
        {
          "id": "medium",
          "name": "Medium",
          "widthPx": 840
        },
        {
          "id": "large",
          "name": "Large",
          "widthPx": 1200
        }
      ]
    }
  },
  "variableOrdering": {
    "strategy": "segment-leading-spaces",
    "maxLeadingSpaces": 40
  },
  "publishRules": [
    {
      "match": {
        "layer": "primitive"
      },
      "publish": false
    },
    {
      "match": {
        "layer": "semantic",
        "foundation": "breakpoints"
      },
      "publish": false
    },
    {
      "match": {
        "layer": "semantic",
        "foundation": "motion"
      },
      "publish": false
    },
    {
      "match": {
        "layer": "semantic",
        "foundation": "z-index"
      },
      "publish": false
    },
    {
      "match": {
        "layer": "semantic",
        "foundation": "effects",
        "pathContains": "blur"
      },
      "publish": false
    }
  ]
}
